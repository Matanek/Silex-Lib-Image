use Image
use Image.JPEG
use Image.PNG
use Image.WebP

func main() {
    var source = Image.canvas(640, 360, Image.Color(236, 72, 153))
    var thumbnail = copy source
        ..crop(360, 360)
        ..resize(256, 256)
        ..grayscale()
        ..contrast(1.15)
        ..sharpen(0.4)

    Image.save(thumbnail, "/private/tmp/silex-image-cascade.png", PNG.Options())
    Image.save(thumbnail, "/private/tmp/silex-image-cascade.jpg", JPEG.Options(quality:90))
    Image.save(thumbnail, "/private/tmp/silex-image-cascade.webp", WebP.Options(lossless:true))
    print("saved PNG, JPEG, and WebP cascade outputs in /private/tmp")
}
